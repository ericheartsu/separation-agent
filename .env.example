# Local dev: SQLite file. Production: Postgres URL.
DATABASE_URL=./local.db

# NextAuth
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Google OAuth (from Google Cloud Console — see SETUP.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Anthropic
ANTHROPIC_API_KEY=

# Craft MFG Workspace domain restriction (only @craft-mfg.com can log in)
ALLOWED_GOOGLE_DOMAIN=craft-mfg.com

# Mock mode — when true, use stubbed responses instead of real Drive/Claude calls.
# Defaults to true if any of the keys above are missing.
MOCK_MODE=true
